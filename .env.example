# ── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── AI ───────────────────────────────────────────────────────────────────────
# Anthropic API key for Claude (required for /api/java/explain and AI coach)
ANTHROPIC_API_KEY=sk-ant-...
# Model override (optional — defaults to claude-sonnet-4-6)
# AI_MODEL=claude-sonnet-4-6

# ── Java runner ───────────────────────────────────────────────────────────────
# Local dev: uses javac/java (JDK 17+ must be installed)
# Vercel: automatically falls back to Piston API (no config needed)
# To use a self-hosted Piston instance, set this:
# PISTON_API_URL=https://emkc.org/api/v2/piston
